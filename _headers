/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Art, the covers and the downloads. The filenames are stable and carry no
# content hash, so a month of cache would serve a stale cover for a month
# after a swap. A week is the compromise.
/assets/*
  Cache-Control: public, max-age=604800

# Not hashed either, and these three are the ones that actually change, so a
# long max-age would pin a stale stylesheet or a stale script. One hour.
/styles.css
  Cache-Control: public, max-age=3600

/app.js
  Cache-Control: public, max-age=3600

/bg.js
  Cache-Control: public, max-age=3600
