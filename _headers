/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Art and social cards change rarely and are never edited in place.
/assets/img/*
  Cache-Control: public, max-age=2592000

/assets/og/*
  Cache-Control: public, max-age=2592000

/assets/workbook/*
  Cache-Control: public, max-age=86400

# No content hashing on these filenames, so a long max-age would serve a stale
# stylesheet for as long as it lasted. One hour.
/assets/css/*
  Cache-Control: public, max-age=3600

/assets/js/*
  Cache-Control: public, max-age=3600

# include.js fetches these on every page load, and they carry the nav, so a
# stale copy is a stale header across the whole site.
/partials/*
  Cache-Control: public, max-age=300
